# =============================================================================
# Lonavala Municipal Council Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Frontend CORS ────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Local dev: http://localhost:3000
# Production: https://lonavalamc.gov.in
CORS_ORIGIN=http://localhost:3000

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=lonavala_mc_dev

# For testing (optional — defaults to DB_NAME_test if not set)
DB_NAME_TEST=lonavala_mc_test

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET
JWT_EXPIRY=24h

# ─── Cloudflare R2 (Current Storage Provider) ────────────────────────────────
# Get these from Cloudflare Dashboard → R2 → Manage API Tokens
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=lonavala-mc
# Public URL for R2 bucket (set up custom domain or use the r2.dev subdomain)
R2_PUBLIC_URL=https://your-bucket.your-account.r2.cloudflarestorage.com

# ─── AWS S3 (Legacy / Future Use — keep for S3 compatibility) ─────────────────
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_BUCKET=lonavala-mc

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# Get credentials from Cloudinary Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Alternatively, use CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ─── Email (Optional — Communication Module) ──────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=noreply@lonavalamc.gov.in
MAIL_PASSWORD=your_mail_password
MAIL_FROM_NAME=Lonavala Municipal Council
MAIL_FROM_EMAIL=noreply@lonavalamc.gov.in

# ─── SMS (Optional — Communication Module) ────────────────────────────────────
SMS_PROVIDER=SMSJUST
SMS_API_URL=http://www.smsjust.com/sms/user/urlsms.php
SMS_USERNAME=your_sms_username
SMS_PASSWORD=your_sms_password
SMS_SENDER_ID=LONAMC
